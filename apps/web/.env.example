# Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Maps (web embeds)
VITE_GOOGLE_MAPS_API_KEY=

# Payment gateways (publishable keys only on the client)
VITE_MOYASAR_PUBLISHABLE_KEY=
VITE_TAMARA_PUBLIC_KEY=

# Requests backend: mock (default — demo, in-memory) | supabase (future, needs server RPCs)
VITE_REQUEST_BACKEND=mock
